# Set default behavior to automatically normalize line endings
* text=auto

# Force LF line endings for these file types on all platforms
*.sh text eol=lf
*.bash text eol=lf
.bashrc text eol=lf
*.lua text eol=lf
*.vim text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files should be left untouched
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary